name: Run HF Text Generation
on:
  workflow_dispatch: # Позволяет запускать вручную по кнопке

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'
      - name: Install dependencies
        run: pip install requests
      - name: Run script
        env:
          HF_TOKEN: ${{ secrets.HF_TOKEN }} # Передаем секрет
        run: python main.py